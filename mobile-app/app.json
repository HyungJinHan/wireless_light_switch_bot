{
  "expo": {
    "name": "light-switch-bot-controller",
    "slug": "light-switch-bot-controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "light-switch-bot-controller",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.hyungjinhan.lightswitchbotcontroller"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0fe1691-a042-4caa-857f-0ac2856f8938"
      }
    },
    "owner": "hyungjinhan",
    "updates": {
      "url": "https://u.expo.dev/d0fe1691-a042-4caa-857f-0ac2856f8938"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
